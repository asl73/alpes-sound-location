# Copiez ce fichier en .env.local pour lancer le site en local (npm run dev).
# Sur Cloudflare Pages, saisissez ces trois variables dans Settings > Environment variables.

# Supabase > Project Settings > API Keys : l'adresse du projet et la clé publishable (sb_publishable_…)
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Adresse du site en ligne (sans / final)
VITE_SITE_URL=https://alpes-sound-location.fr
